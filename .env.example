# Server Configuration
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/smart_campus_db

# Express Session Secret Key (Change this in production)
SESSION_SECRET=smart_campus_super_secret_key_2026

# Allowed College Email Domain (Leave blank to allow any valid email)
ALLOWED_EMAIL_DOMAIN=

# SMTP Configuration for Nodemailer (Optional - if empty, verification link prints in terminal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Smart Campus Portal <noreply@smartcampus.edu>"

# Default Admin Account Credentials (used by npm run create-admin)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@smartcampus.edu
ADMIN_PASSWORD=Admin@12345
